# Loom configuration.  Copy this file to `.env` (the setup wizard does it for you:
# `./setup.sh`).  `.env` is git-ignored — your key never enters the repo.  Every
# entry point (game/main.py, `python -m authoring`, the scripts) auto-loads it.

# Which AI backend drives NPCs and the director.
#   openrouter  — hosted inference (needs OPENROUTER_API_KEY below); no local GPU
#   ollama      — local inference (no key; needs Ollama + a pulled model)
#   fake        — deterministic, offline, no model, no key (the default if unset)
LOOM_PROVIDER=openrouter

# Three model roles, each independently selectable (the setup wizard sets them for you):
#   LOOM_AUTHOR_MODEL   the authoring agent (workbench world-author)
#   LOOM_GM_MODEL       the game master / director (ambient world beats)
#   LOOM_OLLAMA_MODEL / LOOM_OPENROUTER_MODEL   NPC reactions (dialogue)

# ── OpenRouter (hosted) ─────────────────────────────────────────────────────
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# LOOM_OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b   # NPC tier (default)
# LOOM_GM_MODEL=qwen/qwen3.6-27b               # director tier (default)
# LOOM_AUTHOR_MODEL=qwen/qwen3.6-27b           # authoring-agent tier (default)

# ── Ollama (local) ──────────────────────────────────────────────────────────
# LOOM_AUTHOR_MODEL=qwen3.6:27b                # authoring agent
# LOOM_GM_MODEL=qwen3.6:27b                    # game master / director
# LOOM_OLLAMA_MODEL=qwen3.5:35b-a3b            # NPC reactions
# LOOM_OLLAMA_HOST=http://localhost:11434      # (default)

# ── Server bind (optional) ──────────────────────────────────────────────────
# LOOM_HOST=127.0.0.1
# LOOM_PORT=4000

# ── Inference telemetry ─────────────────────────────────────────────────────
# Show each model call in the server log in real time (elapsed · tokens · tok/s).
# On by default; set to 0 to silence.
# LOOM_INFER_LOG=1
